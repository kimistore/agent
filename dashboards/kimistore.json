          "legendFormat": "offsets flushed",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "rate(kimistore_durable_wait_seconds_sum[5m]) / clamp_min(rate(kimistore_durable_wait_seconds_count[5m]), 1e-9)",
