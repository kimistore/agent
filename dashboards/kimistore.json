    {
      "id": 10,
      "type": "timeseries",
      "title": "Request latency",
      "description": "p50/p95/p99 from the request-time histogram. A histogram exposes _bucket/_sum/_count, so the bare name returns nothing; and a mean hides exactly the tail that makes a broker slow. With a 1s flush interval the acks=all tail is dominated by waiting for the next flush, which is what the interval is specified to do -- so p99 is a knob (KIMISTORE_FLUSH_INTERVAL_MS), not a defect.",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0i3veoyn5z4b"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kimistore_request_time_milliseconds_total_bucket[5m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kimistore_request_time_milliseconds_total_bucket[5m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kimistore_request_time_milliseconds_total_bucket[5m])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true
        }
      ],
