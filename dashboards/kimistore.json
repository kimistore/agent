            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "sum(rate(kimistore_compactor_merge_commits_total[5m]))",
          "legendFormat": "commits",
          "instant": false,
          "range": true
