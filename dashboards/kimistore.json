    {
      "id": 5,
      "type": "stat",
      "title": "Compactor idle",
      "description": "Seconds since the last merge that consolidated anything. A large value while the pass rate is flat means the compactor has stopped -- the failure that once ran silently for eight hours. Shows nothing until the first merge, because last_merge is 0 until then and time() minus 0 is the unix epoch.",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0i3veoyn5z4b"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "(time() - max(kimistore_compactor_last_merge_timestamp_seconds)) and (max(kimistore_compactor_last_merge_timestamp_seconds) > 0)",
          "legendFormat": "idle",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
