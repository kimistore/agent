    {
      "id": 4,
      "type": "stat",
      "title": "Uncommitted merged segments",
      "description": "Written minus committed for the compactor. Zero in steady state; a value that only rises is a merge that wrote a segment and never committed it, which nothing else will ever collect.",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0i3veoyn5z4b"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "max(kimistore_compactor_uncommitted_merged_segments)",
          "legendFormat": "uncommitted",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
