    {
      "id": 6,
      "type": "timeseries",
      "title": "Compactor: passes vs merges",
      "description": "The liveness signal. Passes climbing with merges flat is a compactor running and idle; passes flat is one that has stopped. Split across two panels those are indistinguishable, which is what let the compactor sit broken for eight hours while every log line looked normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "dg0i3veoyn5z4b"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "sum(rate(kimistore_compactor_passes_total[5m]))",
          "legendFormat": "passes",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dg0i3veoyn5z4b"
          },
          "editorMode": "code",
          "expr": "sum(rate(kimistore_compactor_merges_total[5m]))",
          "legendFormat": "merges",
          "instant": false,
          "range": true
