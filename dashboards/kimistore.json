{
  "uid": "kimistore",
  "title": "Kimistore",
  "description": "Operational view of the kimistore Kafka-compatible broker on knode3. Built against the metrics the agent actually exposes (v1.0.19).",
  "tags": [
    "kimistore",
    "mimir",
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "mimir-trial",
          "value": "dg0i3veoyn5z4b"
        },
        "hide": 0
      },
      {
        "name": "agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kimistore_agent_live, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Agent live",
      "description": "1 when the agent reports itself live. Anything else means the process is up but not serving.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(kimistore_agent_live{instance=~\"$agent\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "stat",
      "title": "Version",
      "description": "Build info. Useful when a change was deployed and you are not sure it is the one running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "max by (version) (kimistore_build_info{instance=~\"$agent\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "stat",
      "title": "Partitions owned / total",
      "description": "Owned against the partition count known to the cluster. A shortfall means ownership is not fully settled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(kimistore_partitions_owned{instance=~\"$agent\"})",
          "refId": "A",
          "instant": true,
          "legendFormat": "owned"
        },
        {
          "expr": "sum(kimistore_partition_total_count{instance=~\"$agent\"})",
          "refId": "B",
          "instant": true,
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "stat",
      "title": "Uncommitted merged segments",
      "description": "Written-minus-committed for the compactor. Zero in steady state; a value that only rises is a merge that wrote a segment and never committed it, which nothing else will ever collect. This is the gauge that would have caught the 4GB of stranded segments.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(kimistore_compactor_uncommitted_merged_segments{instance=~\"$agent\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "stat",
      "title": "Compactor idle",
      "description": "Seconds since the last merge that consolidated anything. A large value while the passes/merges panel is flat means the compactor has stopped -- the failure that once ran silently for eight hours. Shows nothing until the first merge of the process's life, because last_merge is 0 until then and time() minus 0 is the current unix time rather than a duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "(time() - max(kimistore_compactor_last_merge_timestamp_seconds{instance=~\"$agent\"})) and (max(kimistore_compactor_last_merge_timestamp_seconds{instance=~\"$agent\"}) > 0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "noValue": "no merges yet this process",
          "custom": {},
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Error rates",
      "description": "Everything that should stay flat. Any sustained non-zero line here is a fault, not background noise.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(kimistore_offset_flush_failures_total{instance=~\"$agent\"}[5m]))",
          "refId": "A",
          "legendFormat": "offset flush"
        },
        {
          "expr": "sum(rate(kimistore_ownership_claim_failures_total{instance=~\"$agent\"}[5m]))",
          "refId": "B",
          "legendFormat": "ownership claim"
        },
        {
          "expr": "sum(rate(kimistore_durable_timeouts_total{instance=~\"$agent\"}[5m]))",
          "refId": "C",
          "legendFormat": "durable timeout"
        },
        {
          "expr": "sum(rate(kimistore_object_store_timeouts_total{instance=~\"$agent\"}[5m]))",
          "refId": "D",
          "legendFormat": "object store timeout"
        },
        {
          "expr": "sum(rate(kimistore_lease_renewal_failures_total{instance=~\"$agent\"}[5m]))",
          "refId": "E",
          "legendFormat": "lease renewal"
        },
        {
          "expr": "sum(rate(kimistore_wal_recovery_truncations_total{instance=~\"$agent\"}[5m]))",
          "refId": "F",
          "legendFormat": "wal truncation"
        },
        {
          "expr": "sum(rate(kimistore_compactor_pass_errors_total{instance=~\"$agent\"}[5m]))",
          "refId": "G",
          "legendFormat": "compactor pass"
        },
        {
          "expr": "sum(rate(kimistore_ownership_renewal_failures_total{instance=~\"$agent\"}[5m]))",
          "refId": "H",
          "legendFormat": "ownership renewal"
        },
        {
          "expr": "sum(rate(kimistore_manifest_writes_rejected_total{instance=~\"$agent\"}[5m]))",
          "refId": "I",
          "legendFormat": "manifest write rejected"
        },
        {
          "expr": "sum(rate(kimistore_lease_refused_writes_total{instance=~\"$agent\"}[5m]))",
          "refId": "J",
          "legendFormat": "lease refused writes"
        },
        {
          "expr": "sum(rate(kimistore_ownership_refused_writes_total{instance=~\"$agent\"}[5m]))",
          "refId": "K",
          "legendFormat": "ownership refused writes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "drawStyle": "line",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Compactor: passes vs merges",
      "description": "The liveness signal. Passes climbing with merges flat means the compactor is running and idle. Passes flat means it has stopped -- and on its own that is indistinguishable from a healthy idle compactor unless both are on the same axes, which is why they are here together rather than as separate panels.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(kimistore_compactor_passes_total{instance=~\"$agent\"}[5m]))",
          "refId": "A",
          "legendFormat": "passes"
        },
        {
          "expr": "sum(rate(kimistore_compactor_merges_total{instance=~\"$agent\"}[5m]))",
          "refId": "B",
          "legendFormat": "merges"
        },
        {
          "expr": "sum(rate(kimistore_compactor_merge_commits_total{instance=~\"$agent\"}[5m]))",
          "refId": "C",
          "legendFormat": "commits"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Compaction throughput",
      "description": "Segments written and reclaimed, against passes that hit their time budget. A budget-exhausted rate matching the pass rate means the compactor is throughput-limited; zero while passes climb means it is simply idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(kimistore_compactor_merged_segments_written_total{instance=~\"$agent\"}[5m]))",
          "refId": "A",
          "legendFormat": "segments written"
        },
        {
          "expr": "sum(rate(kimistore_compactor_segments_merged_total{instance=~\"$agent\"}[5m]))",
          "refId": "B",
          "legendFormat": "segments reclaimed"
        },
        {
          "expr": "sum(rate(kimistore_compactor_budget_exhausted_total{instance=~\"$agent\"}[5m]))",
          "refId": "C",
          "legendFormat": "passes budget-exhausted"
        },
        {
          "expr": "sum(rate(kimistore_compactor_passes_total{instance=~\"$agent\"}[5m]))",
          "refId": "D",
          "legendFormat": "passes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "row",
      "title": "Ingest",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum(rate(kimistore_request_count_total{instance=~\"$agent\"}[5m]))",
          "refId": "A",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "description": "",
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Ingest throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum(rate(kimistore_request_size_bytes_total{instance=~\"$agent\"}[5m]))",
          "refId": "A",
          "legendFormat": "bytes in"
        },
        {
          "expr": "sum(rate(kimistore_uploader_bytes_total{instance=~\"$agent\"}[5m]))",
          "refId": "B",
          "legendFormat": "bytes uploaded"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "description": "",
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Request latency",
      "description": "Quantiles from the request-time histogram. p99 rather than a mean, because a mean hides exactly the tail that makes a broker slow. This metric is a histogram, so the query has to go through _bucket -- querying the bare name returns nothing at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kimistore_request_time_milliseconds_total_bucket{instance=~\"$agent\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kimistore_request_time_milliseconds_total_bucket{instance=~\"$agent\"}[5m])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kimistore_request_time_milliseconds_total_bucket{instance=~\"$agent\"}[5m])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Uploader queue",
      "description": "Segments in flight. A queue that climbs without draining is backpressure on the object store.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "max(kimistore_uploader_in_flight_count{instance=~\"$agent\"})",
          "refId": "A",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
      "type": "timeseries",
      "title": "Uploader misses",
      "description": "Missed events. Non-zero means the uploader dropped work.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum(rate(kimistore_uploader_missed_events_total{instance=~\"$agent\"}[5m]))",
          "refId": "A",
          "legendFormat": "missed"
        },
        {
          "expr": "sum(rate(kimistore_uploader_task_total{instance=~\"$agent\"}[5m]))",
          "refId": "B",
          "legendFormat": "tasks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisPlacement": "auto",
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transparent": false,
      "interval": null,
      "links": []
    },
    {
